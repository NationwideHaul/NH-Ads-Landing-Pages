# ============================================================================
#  Nationwide Haul — MAC FL Lightweight LP  |  Environment Variables
#  Copy this file to ".env.local" and fill in the real values.
#  In Vercel: add these under Project Settings → Environment Variables.
# ============================================================================

# --- GoHighLevel Inbound Webhooks (REQUIRED) -------------------------------
# The form POSTs lead data here (server-side, via /app/api/lead/route.js).
# Get these from: GHL → Automation → Workflows → Inbound Webhook trigger.
# English landing (/mac-lightweight-english):
GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/PLACEHOLDER"
# Spanish landing (/mac-lightweight-spanish) — separate workflow.
# If unset, the Spanish form falls back to GHL_WEBHOOK_URL.
GHL_WEBHOOK_URL_ES="https://services.leadconnectorhq.com/hooks/PLACEHOLDER_ES"

# --- Meta Pixel (REQUIRED for the browser "Lead" event) --------------------
# Public — exposed to the browser on purpose so the Pixel can fire.
NEXT_PUBLIC_META_PIXEL_ID="PLACEHOLDER_PIXEL_ID"

# --- Phone number the CTAs dial (REQUIRED) ---------------------------------
# Used by "Talk to our team" / "Call now" buttons. E.164 for tel: links.
NEXT_PUBLIC_PHONE_E164="+18635550100"
NEXT_PUBLIC_PHONE_DISPLAY="(863) 555-0100"

# --- VSL video (OPTIONAL — defaults to the embedded YouTube ad) -------------
# Autoplays muted (browser policy); viewers can unmute. Direct .mp4, YouTube,
# or Vimeo URL all work. Leave blank to use the built-in default video.
NEXT_PUBLIC_VSL_VIDEO_URL="https://www.youtube.com/watch?v=Pr6Fa1Vuvt8"

# --- Yard address shown in the secondary CTA (OPTIONAL) --------------------
NEXT_PUBLIC_YARD_LABEL="Lakeland, FL yard"
NEXT_PUBLIC_YARD_MAPS_URL="https://maps.google.com/?q=Nationwide+Haul+Lakeland+FL"
